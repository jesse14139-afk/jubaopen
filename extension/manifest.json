{
  "manifest_version": 3,
  "name": "JubaOpen Collector",
  "version": "210.3.4.1",
  "version_name": "210.3.5.1 platformCode fix",
  "description": "JubaOpen 210.3.5.1 Threads visible follow-ups platformCode 修复",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JubaOpen"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/wa-page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/direct/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*"
      ],
      "js": [
        "content/meta-page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/message-normalizer.js",
        "content/adapters/whatsapp.js",
        "content/chat-panel.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.telegram.org/a/*",
        "https://web.telegram.org/k/*"
      ],
      "js": [
        "content/message-normalizer.js",
        "content/adapters/telegram.js",
        "content/chat-panel.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/direct/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*"
      ],
      "js": [
        "content/message-normalizer.js",
        "content/adapters/meta-common.js",
        "content/adapters/instagram.js",
        "content/adapters/messenger.js",
        "content/adapters/facebook.js",
        "content/chat-panel.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*",
        "https://www.messenger.com/*",
        "https://www.facebook.com/messages/*",
        "https://web.telegram.org/*",
        "https://www.threads.com/messages/*",
        "https://threads.com/messages/*"
      ],
      "js": [
        "content/followup-notifications.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.threads.com/*",
        "https://threads.com/*"
      ],
      "js": [
        "content/threads-manual-owner.js",
        "content/threads-page-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.threads.com/messages/*",
        "https://threads.com/messages/*"
      ],
      "js": [
        "content/message-normalizer.js",
        "content/adapters/threads.js",
        "content/chat-panel.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
